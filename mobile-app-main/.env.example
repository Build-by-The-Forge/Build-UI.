# Public app configuration. Every EXPO_PUBLIC_ value is bundled into the app and
# readable by anyone: never put a secret here.

# build-backend origin. https is required in a production build.
# Android emulator reaching a backend on the host: http://10.0.2.2:8000
EXPO_PUBLIC_API_BASE_URL=https://staging.api.example.invalid

# The tenant this build serves. Defaults to futa.
EXPO_PUBLIC_TENANT_SLUG=futa

# Development only: serve contract mocks where a backend lane isn't ready.
# A production build refuses to start with this set to true.
# EXPO_PUBLIC_USE_MOCKS=true

# Optional per-request timeout in milliseconds (default 20000).
# EXPO_PUBLIC_API_TIMEOUT_MS=20000
